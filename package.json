{
  "name": "brackenwake",
  "version": "1.0.0",
  "description": "Brackenwake: an open, procedural, endless world, forked from Nostrux Homestead",
  "main": "index.js",
  "scripts": {
    "test": "node run-tests.mjs",
    "dev": "vite",
    "server": "wrangler dev --port 8787",
    "build": "vite build",
    "build:marketing": "node scripts/build-marketing.mjs",
    "preview": "vite preview",
    "deploy": "vite build && npx wrangler deploy",
    "wiki:build": "node scripts/build-wiki.mjs wiki/site/index.html",
    "wiki:deploy": "npx wrangler deploy -c wiki/wrangler.jsonc"
  },
  "keywords": [
    "nostr",
    "game",
    "farming",
    "threejs",
    "three",
    "webgl"
  ],
  "author": "karnagebitcoin",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "three": "^0.186.0",
    "vite": "^8.2.2"
  }
}
