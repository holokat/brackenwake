{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "brackenwake-marketing",
  "main": "server/marketing.mjs",
  "account_id": "0b55a6c39a979a58efbf40875ac376d6",
  "compatibility_date": "2026-09-08",
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist-marketing",
    "not_found_handling": "none",
    "run_worker_first": ["/", "/play", "/play/", "/ws/*"]
  },
  "services": [{ "binding": "GAME", "service": "brackenwake" }],
  "observability": { "enabled": true },
  "routes": [
    {
      "pattern": "brackenwake.com",
      "custom_domain": true
    },
    {
      "pattern": "www.brackenwake.com",
      "custom_domain": true
    }
  ]
}
